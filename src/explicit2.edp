load "gmsh"
load "medit"

// --- 1. MESH & PREP ---
mesh3 Th = gmshload3("../models/brain_tumour_merged.msh");
Th = trunc(Th, (region == 20)); // Keep only brain (remove tumor)
Th = movemesh3(Th, transfo=[x/1000.0, y/1000.0, z/1000.0]);
Th = movemesh3(Th, transfo=[-z, x, -y]);

// BC labels
real brainRadius = 0.07;
real occipitalPin = -4*brainRadius/5;
real brainStemPin = 3*brainRadius/5;
func int newLabel() {
    int lab = 30;
    if (z < occipitalPin)  lab = 31; // Back of head
    if (x > brainStemPin)  lab = 32; // Brainstem
    return lab;
}
Th = change(Th, flabel = newLabel());

// Constants - nu=0.45 is key for stability in FreeFEM P1 elements
real rho = 1036, E = 2000, nu = 0.45, g = -9.81;
real mu = E / (2.0 * (1.0 + nu));
real lambda = E * nu / ((1.0 + nu) * (1.0 - 2.0 * nu));

fespace Vh3(Th, [P1, P1, P1]);
Vh3 [u1, u2, u3] = [0,0,0], [up1, up2, up3] = [0,0,0], [unext1, unext2, unext3] = [0,0,0];

// --- 2. PRE-COMPUTE (TL FORMULATION) ---

// Gravity Force - qforder=1 uses 1-point integration (much faster)
varf vGrav([u1,u2,u3],[v1,v2,v3]) = int3d(Th, qforder=1)(rho * g * v3);
real[int] Fgrav = vGrav(0, Vh3);

// Diagonal Mass Matrix
varf vM([u1,u2,u3],[v1,v2,v3]) = int3d(Th, qforder=1)(rho*u1*v1 + rho*u2*v2 + rho*u3*v3);
real[int] Mdiag = vM(0, Vh3);
real[int] InvM = Mdiag;
for(int i=0; i<InvM.n; i++) InvM[i] = (Mdiag[i] > 1e-18) ? (1.0 / Mdiag[i]) : 0;

// BC Mask (0 = pinned, 1 = free)
real[int] bcMask(Vh3.ndof); bcMask = 1.0;
for (int i = 0; i < Th.nv; i++) {
    if (Th(i).label == 31 || Th(i).label == 32) {
        for (int d = 0; d < 3; d++) bcMask[i*3 + d] = 0.0;
    }
}

// Macros for Strains and Stresses
macro X11(u1,u2,u3) (1.0 + dx(u1)) //
macro X12(u1,u2,u3) (dy(u1))      //
macro X13(u1,u2,u3) (dz(u1))      //
macro X21(u1,u2,u3) (dx(u2))      //
macro X22(u1,u2,u3) (1.0 + dy(u2)) //
macro X23(u1,u2,u3) (dz(u2))      //
macro X31(u1,u2,u3) (dx(u3))      //
macro X32(u1,u2,u3) (dy(u3))      //
macro X33(u1,u2,u3) (1.0 + dz(u3)) //
macro E11(u1,u2,u3) (0.5*(X11(u1,u2,u3)^2 + X21(u1,u2,u3)^2 + X31(u1,u2,u3)^2 - 1.0)) //
macro E22(u1,u2,u3) (0.5*(X12(u1,u2,u3)^2 + X22(u1,u2,u3)^2 + X32(u1,u2,u3)^2 - 1.0)) //
macro E33(u1,u2,u3) (0.5*(X13(u1,u2,u3)^2 + X23(u1,u2,u3)^2 + X33(u1,u2,u3)^2 - 1.0)) //
macro E12(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X12(u1,u2,u3) + X21(u1,u2,u3)*X22(u1,u2,u3) + X31(u1,u2,u3)*X32(u1,u2,u3))) //
macro E13(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X13(u1,u2,u3) + X21(u1,u2,u3)*X23(u1,u2,u3) + X31(u1,u2,u3)*X33(u1,u2,u3))) //
macro E23(u1,u2,u3) (0.5*(X12(u1,u2,u3)*X13(u1,u2,u3) + X22(u1,u2,u3)*X23(u1,u2,u3) + X32(u1,u2,u3)*X33(u1,u2,u3))) //
macro traceE(u1,u2,u3) (E11(u1,u2,u3) + E22(u1,u2,u3) + E33(u1,u2,u3)) //
macro S11(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E11(u1,u2,u3)) //
macro S22(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E22(u1,u2,u3)) //
macro S33(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E33(u1,u2,u3)) //
macro S12(u1,u2,u3) (2.0*mu*E12(u1,u2,u3)) //
macro S13(u1,u2,u3) (2.0*mu*E13(u1,u2,u3)) //
macro S23(u1,u2,u3) (2.0*mu*E23(u1,u2,u3)) //
macro dE11(u1,u2,u3,v1,v2,v3) (X11(u1,u2,u3)*dx(v1) + X21(u1,u2,u3)*dx(v2) + X31(u1,u2,u3)*dx(v3)) //
macro dE22(u1,u2,u3,v1,v2,v3) (X12(u1,u2,u3)*dy(v1) + X22(u1,u2,u3)*dy(v2) + X32(u1,u2,u3)*dy(v3)) //
macro dE33(u1,u2,u3,v1,v2,v3) (X13(u1,u2,u3)*dz(v1) + X23(u1,u2,u3)*dz(v2) + X33(u1,u2,u3)*dz(v3)) //
macro dE12(u1,u2,u3,v1,v2,v3) (0.5*(X11(u1,u2,u3)*dy(v1) + X21(u1,u2,u3)*dy(v2) + X31(u1,u2,u3)*dy(v3) + X12(u1,u2,u3)*dx(v1) + X22(u1,u2,u3)*dx(v2) + X32(u1,u2,u3)*dx(v3))) //
macro dE13(u1,u2,u3,v1,v2,v3) (0.5*(X11(u1,u2,u3)*dz(v1) + X21(u1,u2,u3)*dz(v2) + X31(u1,u2,u3)*dz(v3) + X13(u1,u2,u3)*dx(v1) + X23(u1,u2,u3)*dx(v2) + X33(u1,u2,u3)*dx(v3))) //
macro dE23(u1,u2,u3,v1,v2,v3) (0.5*(X12(u1,u2,u3)*dz(v1) + X22(u1,u2,u3)*dz(v2) + X32(u1,u2,u3)*dz(v3) + X13(u1,u2,u3)*dy(v1) + X23(u1,u2,u3)*dy(v2) + X33(u1,u2,u3)*dy(v3))) //

// Internal Forces - Speed fix: qforder=1
varf internalForce([unused1,unused2,unused3], [v1,v2,v3]) =
    int3d(Th, qforder=1)(
          S11(u1,u2,u3)*dE11(u1,u2,u3,v1,v2,v3) + S22(u1,u2,u3)*dE22(u1,u2,u3,v1,v2,v3) + S33(u1,u2,u3)*dE33(u1,u2,u3,v1,v2,v3)
        + 2.0*S12(u1,u2,u3)*dE12(u1,u2,u3,v1,v2,v3) + 2.0*S13(u1,u2,u3)*dE13(u1,u2,u3,v1,v2,v3) + 2.0*S23(u1,u2,u3)*dE23(u1,u2,u3,v1,v2,v3)
    );
varf vTumourForce([u1,u2,u3],[v1,v2,v3]) =
    int2d(Th, tumourSurfLabel)(
        Fmag * (N.x*v1 + N.y*v2 + N.z*v3)
    );
real[int] Ftumour = vTumourForce(0, Vh3);

// --- 3. TIME LOOP ---
real Tfinal = 0.01, dt = 1.0e-5, eta = 15.0; 
int nsteps = Tfinal/dt;

for (int step = 0; step < nsteps; ++step) {
    // Assembly step
    real[int] Fint = internalForce(0, Vh3);

    // Vectorized Update
    for (int i = 0; i < Vh3.ndof; i++) {
        if (bcMask[i] < 0.5) { 
            unext1[][i] = 0.0; 
        } else {
            // Ramp gravity slowly over first 0.1s to avoid shock
            real ramp = (step*dt < 0.1) ? (step*dt / 0.1) : 1.0;
            real vel = (u1[][i] - up1[][i]) / dt;
            real Accel = (ramp*Fgrav[i] - Fint[i] - eta * Mdiag[i] * vel) * InvM[i];
            unext1[][i] = dt*dt * Accel + 2.0*u1[][i] - up1[][i];
        }
    }

    up1[] = u1[]; u1[] = unext1[]; 
    
    // Print every 50 steps so the console doesn't lag
    if (step % 50 == 0) cout << "Step " << step << " (t=" << step*dt << ")" << endl;
}

// --- 4. SHOW RESULTS ---
mesh3 ThDeformed = movemesh3(Th, transfo=[x+u1, y+u2, z+u3]);

// --- 3. SAVE THE RESULTS ---
// Save the deformed geometry for use in other software (Gmsh/MeshLab)
savemesh(ThDeformed, "brain_deformed_final.mesh");

plot(Th, cmm="Original Pre-Operative Mesh", wait=1);
plot(ThDeformed, cmm="Deformed Intra-Operative Mesh", wait=1);

// --- 5. VISUALIZE DISPLACEMENTS IN MEDIT ---
// This calls the Medit viewer. You can cycle through u1, u2, u3 
// inside the Medit interface by pressing 'v' or 'm'.
medit("X-Displacement", ThDeformed, u1);
medit("Y-Displacement", ThDeformed, u2);
medit("Z-Displacement", ThDeformed, u3);

//what part of tumour is removed?
//how much volume is removed?
//typical forces in the brain