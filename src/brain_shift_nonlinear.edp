{
    ofstream f("results_stats.txt");
    f << "Max_Disp_mm: " << maxDisp * 1000 << endl;
    f << "Tumor_Shift_mm: " << tumorShift * 1000 << endl;
    f << "Vol_Error: " << volChangePercent << endl;
}

