load "gmsh"
load "medit"

//Load in the brain + tumour mesh and apply the necessary transforms to orient the mesh correctly
mesh3 Th = gmshload3("../models/brain_tumour_merged.msh");
Th = movemesh3(Th, transfo=[x/1000.0, y/1000.0, z/1000.0]);
Th = movemesh3(Th, transfo=[-z, x, -y]);

//Add surfaces for pinning
real brainRadius = 0.07;
real occipitalPin = -4*brainRadius/5;
real brainStemPin = 3*brainRadius/5;
func int newLabel() {
    int lab = 30;
    if (region == 10)      lab = 11;  // tumour surface
    if (z < occipitalPin)  lab = 31;  // occipital pin
    if (x > brainStemPin)  lab = 32;  // brainstem pin
    return lab;
}

Th = change(Th, flabel = newLabel());

//Brain constants
real rho = 1036;    // Density of brain
real E = 2000;      // young's modulus (Pa)
real nu = 0.49;   // poisson's ratio
real g = -9.81;  
// Lamé parameters
real mu = E / (2 * (1 + nu));
real lambda = E * nu / ((1 + nu) * (1 - 2 * nu));

//CSF parameters
real rhoFluid = 1000; 
real cutHeight = 0.0;

//Simulation parameters
real Tfinal = 0.5;
real dt = 0.00005;
real nsteps = Tfinal/dt;

//macros

//X_t0 - Deformation Gradient
macro X11(u1,u2,u3) (1.0 + dx(u1)) //
macro X12(u1,u2,u3) (dy(u1))      //
macro X13(u1,u2,u3) (dz(u1))      //

macro X21(u1,u2,u3) (dx(u2))      //
macro X22(u1,u2,u3) (1.0 + dy(u2)) //
macro X23(u1,u2,u3) (dz(u2))      //

macro X31(u1,u2,u3) (dx(u3))      //
macro X32(u1,u2,u3) (dy(u3))      //
macro X33(u1,u2,u3) (1.0 + dz(u3)) //

macro JJ(u1,u2,u3) ( 
    X11(u1,u2,u3)*(X22(u1,u2,u3)*X33(u1,u2,u3) - X23(u1,u2,u3)*X32(u1,u2,u3)) - 
    X12(u1,u2,u3)*(X21(u1,u2,u3)*X33(u1,u2,u3) - X23(u1,u2,u3)*X31(u1,u2,u3)) + 
    X13(u1,u2,u3)*(X21(u1,u2,u3)*X32(u1,u2,u3) - X22(u1,u2,u3)*X31(u1,u2,u3)) 
) //

//E_ij - Green-Lagrange Strain macros
macro E11(u1,u2,u3) (0.5*(X11(u1,u2,u3)^2 + X21(u1,u2,u3)^2 + X31(u1,u2,u3)^2 - 1.0)) //
macro E22(u1,u2,u3) (0.5*(X12(u1,u2,u3)^2 + X22(u1,u2,u3)^2 + X32(u1,u2,u3)^2 - 1.0)) //
macro E33(u1,u2,u3) (0.5*(X13(u1,u2,u3)^2 + X23(u1,u2,u3)^2 + X33(u1,u2,u3)^2 - 1.0)) //

macro E12(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X12(u1,u2,u3) + X21(u1,u2,u3)*X22(u1,u2,u3) + X31(u1,u2,u3)*X32(u1,u2,u3))) //
macro E13(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X13(u1,u2,u3) + X21(u1,u2,u3)*X23(u1,u2,u3) + X31(u1,u2,u3)*X33(u1,u2,u3))) //
macro E23(u1,u2,u3) (0.5*(X12(u1,u2,u3)*X13(u1,u2,u3) + X22(u1,u2,u3)*X23(u1,u2,u3) + X32(u1,u2,u3)*X33(u1,u2,u3))) //

macro traceE(u1,u2,u3) (E11(u1,u2,u3) + E22(u1,u2,u3) + E33(u1,u2,u3)) //

//S_ij - 2nd Piola-Kirchoff Stress macros
macro S11(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E11(u1,u2,u3)) //
macro S22(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E22(u1,u2,u3)) //
macro S33(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E33(u1,u2,u3)) //
macro S12(u1,u2,u3) (2.0*mu*E12(u1,u2,u3)) //
macro S13(u1,u2,u3) (2.0*mu*E13(u1,u2,u3)) //
macro S23(u1,u2,u3) (2.0*mu*E23(u1,u2,u3)) //

// Variation of Green-Lagrange Strain w.r.t Test Functions v1, v2, v3
macro dE11(u1,u2,u3, v1,v2,v3) (X11(u1,u2,u3)*dx(v1) + X21(u1,u2,u3)*dx(v2) + X31(u1,u2,u3)*dx(v3)) //
macro dE22(u1,u2,u3, v1,v2,v3) (X12(u1,u2,u3)*dy(v1) + X22(u1,u2,u3)*dy(v2) + X32(u1,u2,u3)*dy(v3)) //
macro dE33(u1,u2,u3, v1,v2,v3) (X13(u1,u2,u3)*dz(v1) + X23(u1,u2,u3)*dz(v2) + X33(u1,u2,u3)*dz(v3)) //

macro dE12(u1,u2,u3, v1,v2,v3) (0.5*( 
    X11(u1,u2,u3)*dy(v1) + X21(u1,u2,u3)*dy(v2) + X31(u1,u2,u3)*dy(v3) + 
    X12(u1,u2,u3)*dx(v1) + X22(u1,u2,u3)*dx(v2) + X32(u1,u2,u3)*dx(v3) 
)) //

macro dE13(u1,u2,u3, v1,v2,v3) (0.5*( 
    X11(u1,u2,u3)*dz(v1) + X21(u1,u2,u3)*dz(v2) + X31(u1,u2,u3)*dz(v3) + 
    X13(u1,u2,u3)*dx(v1) + X23(u1,u2,u3)*dx(v2) + X33(u1,u2,u3)*dx(v3) 
)) //

macro dE23(u1,u2,u3, v1,v2,v3) (0.5*( 
    X12(u1,u2,u3)*dz(v1) + X22(u1,u2,u3)*dz(v2) + X32(u1,u2,u3)*dz(v3) + 
    X13(u1,u2,u3)*dy(v1) + X23(u1,u2,u3)*dy(v2) + X33(u1,u2,u3)*dy(v3) 
)) //

//utility macros for calculating cross product
macro crossProductX(Ax, Ay, Az, Bx, By, Bz) (Ay*Bz - Az*By)//
macro crossProductY(Ax, Ay, Az, Bx, By, Bz) (Az*Bx - Ax*Bz)//
macro crossProductZ(Ax, Ay, Az, Bx, By, Bz) (Ax*By - Ay*Bx)//

//Finite element spaces to store displacements 
fespace Vh3(Th, [P1, P1, P1]); // Vector space for displacementplot(Th, cmm="Original Pre-Operative Mesh", wait=1);
fespace Vh(Th, P1);

Vh3 [u1, u2, u3] = [0,0,0];      // u_now (u_n)
Vh3 [up1, up2, up3] = [0,0,0];      // u_prev (u_n-1)
Vh3 [unext1, unext2, unext3] = [0,0,0]; // u_next (u_n+1)

//Finite element spcaes to store fluid force components
Vh f1=0; 
Vh f2=0;
Vh f3=0;

//Construct the lumped mass matrix
varf vMLumped([u1,u2,u3], [v1,v2,v3]) = int3d(Th)(rho*v1 + rho*v2 + rho*v3);

//Extract the nodal masses into the Mdiag vector
real[int] Mdiag = vMLumped(0, Vh3); 

//varf for external forces (only gravity for now)
varf residual([unused1,unused2,unused3], [v1,v2,v3]) =

    int3d(Th)( 
        rho * g * v3
    );

//varf to calculate the internal forces
varf internalForce([unused1,unused2,unused3], [v1,v2,v3]) =
    int3d(Th)(
          S11(u1,u2,u3) * dE11(u1,u2,u3, v1,v2,v3)
        + S22(u1,u2,u3) * dE22(u1,u2,u3, v1,v2,v3)
        + S33(u1,u2,u3) * dE33(u1,u2,u3, v1,v2,v3)
        + 2.0 * S12(u1,u2,u3) * dE12(u1,u2,u3, v1,v2,v3)
        + 2.0 * S13(u1,u2,u3) * dE13(u1,u2,u3, v1,v2,v3)
        + 2.0 * S23(u1,u2,u3) * dE23(u1,u2,u3, v1,v2,v3)
    );


//Fluid force calculation
func real calculateFluidForce(real csfHeight) {
    Vh xDeformed = x+u1;
    Vh yDeformed = y+u2;
    Vh zDeformed = z+u3;

    f1[] = 0;
    f2[] = 0;
    f3[] = 0;
    // medit("Fluid Force Vectors", Th, f1, wait=true);


    int nbe = Th.nbe;

    for(int i=0;i<nbe;i++){


        //Getting the indices of the vertices for this surface triangle
        int i1 = Th.be(i)[0];
        int i2 = Th.be(i)[1];
        int i3 = Th.be(i)[2];

        //Getting the z values for those vertices
        real z1 = zDeformed[][i1];
        real z2 = zDeformed[][i2];
        real z3 = zDeformed[][i3];

        real x1 = xDeformed[][i1];
        real x2 = xDeformed[][i2];
        real x3 = xDeformed[][i3];

        real y1 = yDeformed[][i1];
        real y2 = yDeformed[][i2];
        real y3 = yDeformed[][i3];

        real r1 = x1*x1+ y1*y1 + z1*z1;
        real r2 = x2*x2 + y2*y2 + z2*z2;
        real r3 = x3*x3 + y3*y3 + z3*z3;
        if(Th.be(i).label == 11) continue; 
        // cout<<"Triangle "<<i<<"V1: "<<r1<<" V2: "<<r2<<" V3: "<<r3<<endl;

        int submergedCount=0;
        if(z1<=csfHeight) submergedCount++;
        if(z2<=csfHeight) submergedCount++;
        if(z3<=csfHeight) submergedCount++;

        //getting vertex positions for the three vertices
        real[int] j1 = [xDeformed[][i1], yDeformed[][i1], z1]; 
        real[int] j2 = [xDeformed[][i2], yDeformed[][i2], z2];
        real[int] j3 = [xDeformed[][i3], yDeformed[][i3], z3];

        real[int] v1 = [j2[0]-j1[0], j2[1]-j1[1], j2[2]-j1[2]];
        real[int] v2 = [j3[0]-j1[0], j3[1]-j1[1], j3[2]-j1[2]];

        real n1 = crossProductX(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real n2 = crossProductY(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real n3 = crossProductZ(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real mag = sqrt(n1*n1 + n2*n2 + n3*n3);
        real[int] n = [-n1/mag, -n2/mag, -n3/mag]; //unit normal vector


        //All three nodes submerged
        if(submergedCount==3){

            //calculating centroid
            real g1 = j1[0] + j2[0] + j3[0];
            real g2 = j1[1] + j2[1] + j3[1];
            real g3 = j1[2] + j2[2] + j3[2];

            real[int] G = [g1/3, g2/3, g3/3];
            
            

            real S = 0.5*mag;

            real fluidFactor = -(rhoFluid)*abs(g)*(csfHeight - G[2])*S;


            real[int] fluidForce = [fluidFactor * n[0], fluidFactor * n[1], fluidFactor*n[2]];

            real h1 = csfHeight - z1;
            real h2 = csfHeight - z2;
            real h3 = csfHeight - z3;
            real hSum = h1 + h2 + h3;

            //updating fluid force for this time step
            if(hSum > 1e-9){
                f1[][i1] += fluidForce[0] * h1/hSum;
                f2[][i1] += fluidForce[1] * h1/hSum;
                f3[][i1] += fluidForce[2] * h1/hSum;

                f1[][i2] += fluidForce[0] * h2/hSum;
                f2[][i2] += fluidForce[1] * h2/hSum;
                f3[][i2] += fluidForce[2] * h2/hSum;

                f1[][i3] += fluidForce[0] * h3/hSum;
                f2[][i3] += fluidForce[1] * h3/hSum;
                f3[][i3] += fluidForce[2] * h3/hSum;
            }

        }

        if(submergedCount==2){
            real[int] psub1 = [0, 0, 0];
            real[int] psub2 = [0, 0, 0];
            real[int] pair = [0, 0, 0];

            int isub1, isub2 = 0;

            if (z1 > csfHeight) { pair = j1; psub1 = j2; isub1 = i2; psub2 = j3; isub2 = i3;}
            else if (z2 > csfHeight) { pair = j2; psub1 = j1; isub1 = i1; psub2 = j3; isub2 = i3;}
            else { pair = j3; psub1 = j1; isub1 = i1; psub2 = j2; isub2 = i2;}

            real t1 = (csfHeight - psub1[2]) / (pair[2] - psub1[2]);

            real[int] pint1 = [psub1[0] + t1*(pair[0] - psub1[0]), psub1[1] + t1*(pair[1] - psub1[1]), psub1[2] + t1*(pair[2] - psub1[2])];

            real t2 = (csfHeight - psub2[2]) / (pair[2] - psub2[2]);

            real[int] pint2 = [psub2[0] + t2*(pair[0] - psub2[0]), psub2[1] + t2*(pair[1] - psub2[1]), psub2[2] + t2*(pair[2] - psub2[2])];

            // Force on Triangle A
            real [int] Ga = [(psub1[0] + psub2[0] + pint1[0])/3., (psub1[1] + psub2[1] + pint1[1])/3., (psub1[2] + psub2[2] + pint1[2])/3.];

            real[int] vA1 = [psub2[0] - psub1[0], psub2[1] - psub1[1], psub2[2] - psub1[2]];
            real[int] vA2 = [pint1[0] - psub1[0], pint1[1] - psub1[1], pint1[2] - psub1[2]];

            real Sa1 = crossProductX(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);
            real Sa2 = crossProductY(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);
            real Sa3 = crossProductZ(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);

            real Sa = 0.5 * sqrt(Sa1*Sa1 + Sa2*Sa2 + Sa3*Sa3);
            real fluidFactorA = -rhoFluid *abs(g) * (csfHeight-Ga[2])*Sa;
            real[int] fluidForceA = [fluidFactorA * n[0], fluidFactorA * n[1], fluidFactorA*n[2]];

            // Force on Triangle B
            real [int] Gb = [(pint2[0] + psub2[0] + pint1[0])/3., (pint2[1] + psub2[1] + pint1[1])/3., (pint2[2] + psub2[2] + pint1[2])/3.];

            real[int] vB1 = [pint2[0] - psub2[0], pint2[1] - psub2[1], pint2[2] - psub2[2]];
            real[int] vB2 = [pint1[0] - psub2[0], pint1[1] - psub2[1], pint1[2] - psub2[2]];

            real Sb1 = crossProductX(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);
            real Sb2 = crossProductY(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);
            real Sb3 = crossProductZ(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);

            real Sb = 0.5 * sqrt(Sb1*Sb1 + Sb2*Sb2 + Sb3*Sb3);
            real fluidFactorB = -rhoFluid *abs(g) * (csfHeight-Gb[2])*Sb;
            real[int] fluidForceB = [fluidFactorB * n[0], fluidFactorB * n[1], fluidFactorB*n[2]];

            real h1 = csfHeight - psub1[2];
            real h2 = csfHeight - psub2[2];
            real hSum = h1 + h2;
            if (hSum > 1e-9) {
                f1[][isub1] += fluidForceA[0] * h1/hSum;
                f2[][isub1] += fluidForceA[1] * h1/hSum;
                f3[][isub1] += fluidForceA[2] * h1/hSum;

                f1[][isub2] += fluidForceA[0] * h2/hSum + fluidForceB[0];
                f2[][isub2] += fluidForceA[1] * h2/hSum + fluidForceB[1];
                f3[][isub2] += fluidForceA[2] * h2/hSum + fluidForceB[2];
            }


        }
        if(submergedCount==1){
            real[int] psub = [0, 0, 0];
            real[int] pair1 = [0, 0, 0];
            real[int] pair2 = [0, 0, 0];
            int isub;

            // Find which vertex is submerged
            if (z1 <= csfHeight) { psub = j1; isub = i1; pair1 = j2; pair2 = j3;}
            else if (z2 <= csfHeight) { psub = j2; isub = i2; pair1 = j1; pair2 = j3;}
            else { psub = j3; isub = i3; pair1 = j1; pair2 = j2;}

            real t1 = (csfHeight - psub[2]) / (pair1[2] - psub[2]);
            real[int] pint1 = [psub[0] + t1 * (pair1[0] - psub[0]), psub[1] + t1 * (pair1[1] - psub[1]), psub[2] + t1 * (pair1[2] - psub[2])];

            real t2 = (csfHeight - psub[2]) / (pair2[2] - psub[2]);
            real[int] pint2 = [psub[0] + t2 * (pair2[0] - psub[0]), psub[1] + t2 * (pair2[1] - psub[1]), psub[2] + t2 * (pair2[2] - psub[2])];

            real[int] G = [(psub[0] + pint2[0] + pint1[0])/3., (psub[1] + pint2[1] + pint1[1])/3., (psub[2] + pint2[2] + pint1[2])/3.];

            real [int] v1 = [pint1[0] - psub[0], pint1[1] - psub[1], pint1[2] - psub[2]];
            real [int] v2 = [pint2[0] - psub[0], pint2[1] - psub[1], pint2[2] - psub[2]];

            real S1 = crossProductX(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
            real S2 = crossProductY(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
            real S3 = crossProductZ(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);

            real S = 0.5 * sqrt(S1*S1 + S2*S2 + S3*S3);

            real fluidFactor = -rhoFluid * abs(g) * (csfHeight - G[2]) * S;

            real[int] fluidForce = [fluidFactor * n[0], fluidFactor * n[1], fluidFactor*n[2]];
            
            f1[][isub] += fluidForce[0];
            f2[][isub] += fluidForce[1];
            f3[][isub] += fluidForce[2];

        }

    }

    // medit("Fluid Force Vectors", Th, f1, wait=true);

}

//Time stepping loop
for (int step = 0; step < nsteps; ++step) {
    real t = step * dt;

    //Assemble external forces vector
    real[int] Fext = residual(0, Vh3); 
    
    // 2. Fluid Force (Buoyancy)
    real currentCsfHeight = brainRadius + (cutHeight - brainRadius) * (t / Tfinal); // update height based on t
    calculateFluidForce(currentCsfHeight);
    for(int i=0; i < Th.nv; i++) {
        Fext[i*3 + 0] += f1[][i];
        Fext[i*3 + 1] += f2[][i];
        Fext[i*3 + 2] += f3[][i];
    }

    
    //Assemble internal force vector
    real[int] Fint = internalForce(0, Vh3);

    // Update displacement for the next step using the central difference scheme
    for (int i = 0; i < Vh3.ndof; i++) {
        // next_u = (dt^2 / M) * (Fext - Fint) + 2*u_now - u_prev
        unext1[][i] = (dt*dt / Mdiag[i]) * (Fext[i] - Fint[i]) + 2.0*u1[][i] - up1[][i];
    }

    // Manually apply boundary conditions
    for (int i = 0; i < Th.nv; i++) {
        if (Th(i).z < occipitalPin || Th(i).x > brainStemPin) {
            for (int d = 0; d < 3; d++) {
                int dof = i*3 + d;
                u1[][dof] = 0.0;
            }
        }
    }

    // E. UPDATE VECTORS FOR NEXT STEP (Shifting the memory)
    up1[] = u1[];    // Previous becomes current
    u1[] = unext1[]; // Current becomes next
    
    cout << "Step " << step << " completed (t=" << t << ")" << endl;
}

mesh3 ThDeformed = movemesh3(Th, transfo=[x+u1, y+u2, z+u3]);

// --- 3. SAVE THE RESULTS ---
// Save the deformed geometry for use in other software (Gmsh/MeshLab)
savemesh(ThDeformed, "brain_deformed_final.mesh");

plot(Th, cmm="Original Pre-Operative Mesh", wait=1);
plot(ThDeformed, cmm="Deformed Intra-Operative Mesh", wait=1);

// --- 5. VISUALIZE DISPLACEMENTS IN MEDIT ---
// This calls the Medit viewer. You can cycle through u1, u2, u3 
// inside the Medit interface by pressing 'v' or 'm'.
medit("X-Displacement", ThDeformed, u1);
medit("Y-Displacement", ThDeformed, u2);
medit("Z-Displacement", ThDeformed, u3);

// Alternatively, view them as a combined vector field
medit("Total Brain Shift Vector Field", ThDeformed, [u1, u2, u3]);

// --- 6. OPTIONAL SUMMARY STATISTICS ---
Vh dispMag = sqrt(u1^2 + u2^2 + u3^2);
cout << "--------- FINAL STATISTICS ---------" << endl;
cout << "Max Brain Shift:  " << dispMag[].max * 1000 << " mm" << endl;
cout << "Mean Brain Shift: " << (int3d(Th)(dispMag) / int3d(Th)(1.0)) * 1000 << " mm" << endl;
cout << "------------------------------------" << endl;