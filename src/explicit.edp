load "gmsh"
load "medit"

//Load in the brain + tumour mesh and apply the necessary transforms to orient the mesh correctly
mesh3 Th = gmshload3("../models/brain_tumour_merged.msh");
Th = trunc(Th, (region == 20));
Th = movemesh3(Th, transfo=[x/1000.0, y/1000.0, z/1000.0]);
Th = movemesh3(Th, transfo=[-z, x, -y]);

//Add surfaces for pinning
real brainRadius = 0.07;
real occipitalPin = -4*brainRadius/5;
real brainStemPin = 3*brainRadius/5;
func int newLabel() {
    int lab = 30;
    if (region == 10)      lab = 11;  // tumour surface
    if (z < occipitalPin)  lab = 31;  // occipital pin
    if (x > brainStemPin)  lab = 32;  // brainstem pin
    return lab;
}

Th = change(Th, flabel = newLabel());

//Brain constants
real rho = 1036;    // Density of brain
real E = 2000;      // young's modulus (Pa)
real nu = 0.49;   // poisson's ratio
real g = -9.81;  
// Lamé parameters
real mu = E / (2 * (1 + nu));
real lambda = E * nu / ((1 + nu) * (1 - 2 * nu));

//CSF parameters
real rhoFluid = 1000; 
real cutHeight = 0.0;

//Simulation parameters
real Tfinal = 0.5;
real dt = 0.00005;
real nsteps = Tfinal/dt;

//macros

//X_t0 - Deformation Gradient
macro X11(u1,u2,u3) (1.0 + dx(u1)) //
macro X12(u1,u2,u3) (dy(u1))      //
macro X13(u1,u2,u3) (dz(u1))      //

macro X21(u1,u2,u3) (dx(u2))      //
macro X22(u1,u2,u3) (1.0 + dy(u2)) //
macro X23(u1,u2,u3) (dz(u2))      //

macro X31(u1,u2,u3) (dx(u3))      //
macro X32(u1,u2,u3) (dy(u3))      //
macro X33(u1,u2,u3) (1.0 + dz(u3)) //

macro JJ(u1,u2,u3) ( 
    X11(u1,u2,u3)*(X22(u1,u2,u3)*X33(u1,u2,u3) - X23(u1,u2,u3)*X32(u1,u2,u3)) - 
    X12(u1,u2,u3)*(X21(u1,u2,u3)*X33(u1,u2,u3) - X23(u1,u2,u3)*X31(u1,u2,u3)) + 
    X13(u1,u2,u3)*(X21(u1,u2,u3)*X32(u1,u2,u3) - X22(u1,u2,u3)*X31(u1,u2,u3)) 
) //

//E_ij - Green-Lagrange Strain macros
macro E11(u1,u2,u3) (0.5*(X11(u1,u2,u3)^2 + X21(u1,u2,u3)^2 + X31(u1,u2,u3)^2 - 1.0)) //
macro E22(u1,u2,u3) (0.5*(X12(u1,u2,u3)^2 + X22(u1,u2,u3)^2 + X32(u1,u2,u3)^2 - 1.0)) //
macro E33(u1,u2,u3) (0.5*(X13(u1,u2,u3)^2 + X23(u1,u2,u3)^2 + X33(u1,u2,u3)^2 - 1.0)) //

macro E12(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X12(u1,u2,u3) + X21(u1,u2,u3)*X22(u1,u2,u3) + X31(u1,u2,u3)*X32(u1,u2,u3))) //
macro E13(u1,u2,u3) (0.5*(X11(u1,u2,u3)*X13(u1,u2,u3) + X21(u1,u2,u3)*X23(u1,u2,u3) + X31(u1,u2,u3)*X33(u1,u2,u3))) //
macro E23(u1,u2,u3) (0.5*(X12(u1,u2,u3)*X13(u1,u2,u3) + X22(u1,u2,u3)*X23(u1,u2,u3) + X32(u1,u2,u3)*X33(u1,u2,u3))) //

macro traceE(u1,u2,u3) (E11(u1,u2,u3) + E22(u1,u2,u3) + E33(u1,u2,u3)) //

//S_ij - 2nd Piola-Kirchoff Stress macros
macro S11(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E11(u1,u2,u3)) //
macro S22(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E22(u1,u2,u3)) //
macro S33(u1,u2,u3) (lambda*traceE(u1,u2,u3) + 2.0*mu*E33(u1,u2,u3)) //
macro S12(u1,u2,u3) (2.0*mu*E12(u1,u2,u3)) //
macro S13(u1,u2,u3) (2.0*mu*E13(u1,u2,u3)) //
macro S23(u1,u2,u3) (2.0*mu*E23(u1,u2,u3)) //

// Variation of Green-Lagrange Strain w.r.t Test Functions v1, v2, v3
macro dE11(u1,u2,u3, v1,v2,v3) (X11(u1,u2,u3)*dx(v1) + X21(u1,u2,u3)*dx(v2) + X31(u1,u2,u3)*dx(v3)) //
macro dE22(u1,u2,u3, v1,v2,v3) (X12(u1,u2,u3)*dy(v1) + X22(u1,u2,u3)*dy(v2) + X32(u1,u2,u3)*dy(v3)) //
macro dE33(u1,u2,u3, v1,v2,v3) (X13(u1,u2,u3)*dz(v1) + X23(u1,u2,u3)*dz(v2) + X33(u1,u2,u3)*dz(v3)) //

macro dE12(u1,u2,u3, v1,v2,v3) (0.5*( 
    X11(u1,u2,u3)*dy(v1) + X21(u1,u2,u3)*dy(v2) + X31(u1,u2,u3)*dy(v3) + 
    X12(u1,u2,u3)*dx(v1) + X22(u1,u2,u3)*dx(v2) + X32(u1,u2,u3)*dx(v3) 
)) //

macro dE13(u1,u2,u3, v1,v2,v3) (0.5*( 
    X11(u1,u2,u3)*dz(v1) + X21(u1,u2,u3)*dz(v2) + X31(u1,u2,u3)*dz(v3) + 
    X13(u1,u2,u3)*dx(v1) + X23(u1,u2,u3)*dx(v2) + X33(u1,u2,u3)*dx(v3) 
)) //

macro dE23(u1,u2,u3, v1,v2,v3) (0.5*( 
    X12(u1,u2,u3)*dz(v1) + X22(u1,u2,u3)*dz(v2) + X32(u1,u2,u3)*dz(v3) + 
    X13(u1,u2,u3)*dy(v1) + X23(u1,u2,u3)*dy(v2) + X33(u1,u2,u3)*dy(v3) 
)) //

//utility macros for calculating cross product
macro crossProductX(Ax, Ay, Az, Bx, By, Bz) (Ay*Bz - Az*By)//
macro crossProductY(Ax, Ay, Az, Bx, By, Bz) (Az*Bx - Ax*Bz)//
macro crossProductZ(Ax, Ay, Az, Bx, By, Bz) (Ax*By - Ay*Bx)//

//Finite element spaces to store displacements 
fespace Vh3(Th, [P1, P1, P1]); // Vector space for displacementplot(Th, cmm="Original Pre-Operative Mesh", wait=1);
fespace Vh(Th, P1);

Vh3 [u1, u2, u3] = [0,0,0];      // u_now (u_n)
Vh3 [up1, up2, up3] = [0,0,0];      // u_prev (u_n-1)
Vh3 [unext1, unext2, unext3] = [0,0,0]; // u_next (u_n+1)

//Finite element spcaes to store fluid force components
Vh f1=0; 
Vh f2=0;
Vh f3=0;

//Construct the lumped mass matrix
varf vMLumped([u1,u2,u3], [v1,v2,v3]) = int3d(Th)(rho*v1 + rho*v2 + rho*v3);

//Extract the nodal masses into the Mdiag vector
real[int] Mdiag = vMLumped(0, Vh3); 

//varf for external forces (only gravity for now)
varf residual([unused1,unused2,unused3], [v1,v2,v3]) =

    int3d(Th)( 
        rho * g * v3
    );

//varf to calculate the internal forces
varf internalForce([unused1,unused2,unused3], [v1,v2,v3]) =
    int3d(Th)(
          S11(u1,u2,u3) * dE11(u1,u2,u3, v1,v2,v3)
        + S22(u1,u2,u3) * dE22(u1,u2,u3, v1,v2,v3)
        + S33(u1,u2,u3) * dE33(u1,u2,u3, v1,v2,v3)
        + 2.0 * S12(u1,u2,u3) * dE12(u1,u2,u3, v1,v2,v3)
        + 2.0 * S13(u1,u2,u3) * dE13(u1,u2,u3, v1,v2,v3)
        + 2.0 * S23(u1,u2,u3) * dE23(u1,u2,u3, v1,v2,v3)
    );



real maxPush = 0.01; 
//Time stepping loop
for (int step = 0; step < nsteps; ++step) {
    real t = step * dt;


    //Assemble external forces vector
    real[int] Fext = residual(0, Vh3); 
    
    real[int] Fint = internalForce(0, Vh3);

    // Update displacement for the next step using the central difference scheme
    for (int i = 0; i < Vh3.ndof; i++) {
        // next_u = (dt^2 / M) * (Fext - Fint) + 2*u_now - u_prev
        unext1[][i] = (dt*dt / Mdiag[i]) * (Fext[i] - Fint[i]) + 2.0*u1[][i] - up1[][i];
    }

    // Manually apply boundary conditions
    for (int i = 0; i < Th.nv; i++) {
        if (Th(i).z < occipitalPin || Th(i).x > brainStemPin) {
            for (int d = 0; d < 3; d++) {
                int dof = i*3 + d;
                u1[][dof] = 0.0;
            }
        }
    }


    // E. UPDATE VECTORS FOR NEXT STEP (Shifting the memory)
    up1[] = u1[];    // Previous becomes current
    u1[] = unext1[]; // Current becomes next
    
    cout << "Step " << step << " completed (t=" << t << ")" << endl;
}

mesh3 ThDeformed = movemesh3(Th, transfo=[x+u1, y+u2, z+u3]);

// --- 3. SAVE THE RESULTS ---
// Save the deformed geometry for use in other software (Gmsh/MeshLab)
savemesh(ThDeformed, "brain_deformed_final.mesh");

plot(Th, cmm="Original Pre-Operative Mesh", wait=1);
plot(ThDeformed, cmm="Deformed Intra-Operative Mesh", wait=1);

// --- 5. VISUALIZE DISPLACEMENTS IN MEDIT ---
// This calls the Medit viewer. You can cycle through u1, u2, u3 
// inside the Medit interface by pressing 'v' or 'm'.
medit("X-Displacement", ThDeformed, u1);
medit("Y-Displacement", ThDeformed, u2);
medit("Z-Displacement", ThDeformed, u3);

// Alternatively, view them as a combined vector field
medit("Total Brain Shift Vector Field", ThDeformed, [u1, u2, u3]);

// --- 6. OPTIONAL SUMMARY STATISTICS ---
Vh dispMag = sqrt(u1^2 + u2^2 + u3^2);
cout << "--------- FINAL STATISTICS ---------" << endl;
cout << "Max Brain Shift:  " << dispMag[].max * 1000 << " mm" << endl;
cout << "Mean Brain Shift: " << (int3d(Th)(dispMag) / int3d(Th)(1.0)) * 1000 << " mm" << endl;
cout << "------------------------------------" << endl;