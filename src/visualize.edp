load "msh3"
load "gmsh"

mesh3 Th = gmshload3("../scripts/brain_tv.msh");
Th = movemesh3(Th, transfo=[x/1000.0, y/1000.0, z/1000.0]);
Th = movemesh3(Th, transfo=[-z, x, -y]);

mesh3 ThBrain      = trunc(Th, (region == 20));
mesh3 ThTumour     = trunc(Th, (region == 10));
mesh3 ThVentricles = trunc(Th, (region == 30));

cout << "Brain tets:      " << ThBrain.nt << endl;
cout << "Tumour tets:     " << ThTumour.nt << endl;
cout << "Ventricle tets:  " << ThVentricles.nt << endl;

plot(ThBrain,      wait=1, cmm="Brain (region 20)");
plot(ThTumour,     wait=1, cmm="Tumour (region 10)");
plot(ThVentricles, wait=1, cmm="Ventricles (region 30)");
