load "msh3"
load "tetgen"
load "medit"
load "gmsh"
include "MeshSurface.idp"
load "MUMPS"
// load "bem"

int rank = mpirank; // ID of current processor
int size = mpisize; 

// Mesh Parameters
real brainRadius = 0.07;
real brainMeshSize = 0.01;

real tumourRadius = 0.01;
real tumourMeshSize = 0.005;

//Simulation Parameters
real rho = 1036;    // Density of brain
real E = 7070;      // young's modulus (Pa)
real nu = 0.4925;   // poisson's ratio
real g = -9.81;  

real Tfinal = 0.2;
real drainTime = 0.05;  // Time to drain CSF (adjust as needed)

real dt = 0.01;
real nsteps=Tfinal/dt;

// Lamé parameters
real mu = E / (2 * (1 + nu));
real lambda = E * nu / ((1 + nu) * (1 - 2 * nu));

real alpha = 0.02;   // Mass-proportional damping coefficient
real beta = 0.02;    // Stiffness-proportional damping coefficient

// Solver Parameters (no Newton-Raphson needed for linear!)
real tol = 1e-6;

//fluid region
real rhoFluid = 1000;  
real hFluid = 0.0;
mesh3 Th;

if(rank==0){
    // meshS brain = Sphere(brainRadius, brainMeshSize, 10, 0, 0, 0, 1);
    // meshS tumour = Sphere(tumourRadius, tumourMeshSize, 20, 0.02, 0.02, 0.02, 1);
    // meshS consolidatedMesh = brain + tumour;


    // real voltet = (brainMeshSize^3)/6.;
    // cout << "voltet = " << voltet << endl;

    // real[int] domain = [0.0, 0.0, 0.0, 1, voltet,   // Seed for brain region
    //                     0.02, 0.02, 0.02, 2, voltet];  // Seed for tumour region

    // Th = tetg(consolidatedMesh, switch="pqaAAYYQ", nbofregions=2, regionlist=domain);
    Th = gmshload3("../models/brain_tumour_merged.msh");
    Th = movemesh3(Th, transfo=[x/1000.0, y/1000.0, z/1000.0]);
    Th = movemesh3(Th, transfo=[-z, x, -y]);


}
broadcast(processor(0), Th);

fespace Vh(Th, P1);
fespace Vh3(Th, [P1, P1, P1]); // Vector space for displacement

// Current displacement, velocity, acceleration
Vh3 [u1, u2, u3] = [0, 0, 0];     
Vh3 [v1, v2, v3] = [0, 0, 0]; 
Vh3 [a1, a2, a3] = [0, 0, 0];     

// Previous time step values
Vh3 [u1old, u2old, u3old] = [0, 0, 0];     
Vh3 [v1old, v2old, v3old] = [0, 0, 0]; 
Vh3 [a1old, a2old, a3old] = [0, 0, 0];     

// Fluid forces
Vh f1=0;
Vh f2=0;
Vh f3=0;

// real initialCsfHeight = 1.2*brainRadius;

real initialCsfHeight = 0.068;
real currentCsfHeight = initialCsfHeight;
real cutHeight = 0.0;
real occipitalPin = -3*brainRadius/5;
real brainStemPin = 0.05;


macro epsilon11(u1,u2,u3) (dx(u1)) //
macro epsilon22(u1,u2,u3) (dy(u2)) //
macro epsilon33(u1,u2,u3) (dz(u3)) //
macro epsilon12(u1,u2,u3) (0.5*(dy(u1) + dx(u2))) //
macro epsilon13(u1,u2,u3) (0.5*(dz(u1) + dx(u3))) //
macro epsilon23(u1,u2,u3) (0.5*(dz(u2) + dy(u3))) //

// Trace of strain tensor
macro trepsilon(u1,u2,u3) (epsilon11(u1,u2,u3) + epsilon22(u1,u2,u3) + epsilon33(u1,u2,u3)) //

macro sigma11(u1,u2,u3) (lambda*trepsilon(u1,u2,u3) + 2*mu*epsilon11(u1,u2,u3)) //
macro sigma22(u1,u2,u3) (lambda*trepsilon(u1,u2,u3) + 2*mu*epsilon22(u1,u2,u3)) //
macro sigma33(u1,u2,u3) (lambda*trepsilon(u1,u2,u3) + 2*mu*epsilon33(u1,u2,u3)) //
macro sigma12(u1,u2,u3) (2*mu*epsilon12(u1,u2,u3)) //
macro sigma13(u1,u2,u3) (2*mu*epsilon13(u1,u2,u3)) //
macro sigma23(u1,u2,u3) (2*mu*epsilon23(u1,u2,u3)) //

macro crossProductX(Ax, Ay, Az, Bx, By, Bz) (Ay*Bz - Az*By)//
macro crossProductY(Ax, Ay, Az, Bx, By, Bz) (Az*Bx - Ax*Bz)//
macro crossProductZ(Ax, Ay, Az, Bx, By, Bz) (Ax*By - Ay*Bx)//


varf vMass([du1,du2,du3], [w1,w2,w3]) = int3d(Th)(rho * (du1*w1 + du2*w2 + du3*w3));

matrix Mconsistent = vMass(Vh3, Vh3);

real[int] ones(Vh3.ndof);
ones = 1.0;

real[int] Mlumpeddiag = Mconsistent * ones; 

matrix M = Mlumpeddiag;

// cout << "Lumped Mass Matrix M constructed." << endl;
real totalMass = Mlumpeddiag.sum / 3.0; // Divide by 3 because each node has x,y,z mass
real expectedMass = rho * (4./3. * pi * brainRadius^3); // Volume of a sphere
// cout << "Total Simulated Mass: " << totalMass << " kg" << endl;
// cout << "Expected Theoretical Mass: " << expectedMass << " kg" << endl;

varf stiffness([u1,u2,u3], [w1,w2,w3]) =
    int3d(Th)( 
        // sigma : epsilon(w)
          sigma11(u1,u2,u3)*epsilon11(w1,w2,w3)
        + sigma22(u1,u2,u3)*epsilon22(w1,w2,w3)  
        + sigma33(u1,u2,u3)*epsilon33(w1,w2,w3)
        + 2*sigma12(u1,u2,u3)*epsilon12(w1,w2,w3)
        + 2*sigma13(u1,u2,u3)*epsilon13(w1,w2,w3)
        + 2*sigma23(u1,u2,u3)*epsilon23(w1,w2,w3)
    );
    // + on(z < occipitalPin || x>brainStemPin, u1=0, u2=0, u3=0);  // Fixed boundary

// matrix K = stiffness(Vh3, Vh3, solver=UMFPACK);
matrix K = stiffness(Vh3, Vh3, solver=sparsesolver, master=-1);




matrix C = alpha*M + beta*K;


real gammanewmark = 0.5;
real betanewmark = 0.25;

matrix Meff = M + (gammanewmark*dt)*C + (betanewmark*dt*dt)*K;

set(Meff, solver=sparsesolver);




func real calculateFluidForce(real csfHeight) {
    Vh xDeformed = x+u1;
    Vh yDeformed = y+u2;
    Vh zDeformed = z+u3;

    f1[] = 0;
    f2[] = 0;
    f3[] = 0;

    int nbe = Th.nbe;
    int processedTriangles=0;
    int case1count = 0;
    int case2count = 0;
    int case3count = 0;
    for(int i=0;i<nbe;i++){

        //Getting the indices of the vertices for this surface triangle
        int i1 = Th.be(i)[0];
        int i2 = Th.be(i)[1];
        int i3 = Th.be(i)[2];

        //Getting the z values for those vertices
        real z1 = zDeformed[][i1];
        real z2 = zDeformed[][i2];
        real z3 = zDeformed[][i3];

        real x1 = xDeformed[][i1];
        real x2 = xDeformed[][i2];
        real x3 = xDeformed[][i3];

        real y1 = yDeformed[][i1];
        real y2 = yDeformed[][i2];
        real y3 = yDeformed[][i3];

        // Skip inner sphere (tumor)
        real r1 = x1*x1+ y1*y1 + z1*z1;
        real r2 = x2*x2 + y2*y2 + z2*z2;
        real r3 = x3*x3 + y3*y3 + z3*z3;
        if((r1 + r2 + r3)<1.2*tumourRadius){continue;}
        processedTriangles++;
        

        int submergedCount=0;
        if(z1<=csfHeight) submergedCount++;
        if(z2<=csfHeight) submergedCount++;
        if(z3<=csfHeight) submergedCount++;

        //getting vertex positions for the three vertices
        real[int] j1 = [xDeformed[][i1], yDeformed[][i1], z1]; 
        real[int] j2 = [xDeformed[][i2], yDeformed[][i2], z2];
        real[int] j3 = [xDeformed[][i3], yDeformed[][i3], z3];

        real[int] v1 = [j2[0]-j1[0], j2[1]-j1[1], j2[2]-j1[2]];
        real[int] v2 = [j3[0]-j1[0], j3[1]-j1[1], j3[2]-j1[2]];

        real n1 = crossProductX(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real n2 = crossProductY(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real n3 = crossProductZ(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
        real mag = sqrt(n1*n1 + n2*n2 + n3*n3);
        real[int] n = [-n1/mag, -n2/mag, -n3/mag]; //unit normal vector
        // real[int] n = [n1/mag, n2/mag, n3/mag]; //unit normal vector


        //All three nodes submerged
        if(submergedCount==3){

            //calculating centroid
            real g1 = j1[0] + j2[0] + j3[0];
            real g2 = j1[1] + j2[1] + j3[1];
            real g3 = j1[2] + j2[2] + j3[2];

            real[int] G = [g1/3, g2/3, g3/3];

            real S = 0.5*mag;

            real fluidFactor = -(rhoFluid)*abs(g)*(csfHeight - G[2])*S;

            real[int] fluidForce = [fluidFactor * n[0], fluidFactor * n[1], fluidFactor*n[2]];

            real h1 = csfHeight - z1;
            real h2 = csfHeight - z2;
            real h3 = csfHeight - z3;
            real hSum = h1 + h2 + h3;

            //updating fluid force for this time step
            if(hSum > 1e-9){
                f1[][i1] += fluidForce[0] * h1/hSum;
                f2[][i1] += fluidForce[1] * h1/hSum;
                f3[][i1] += fluidForce[2] * h1/hSum;

                f1[][i2] += fluidForce[0] * h2/hSum;
                f2[][i2] += fluidForce[1] * h2/hSum;
                f3[][i2] += fluidForce[2] * h2/hSum;

                f1[][i3] += fluidForce[0] * h3/hSum;
                f2[][i3] += fluidForce[1] * h3/hSum;
                f3[][i3] += fluidForce[2] * h3/hSum;
            }

            case3count++;
        }

        if(submergedCount==2){
            real[int] psub1 = [0, 0, 0];
            real[int] psub2 = [0, 0, 0];
            real[int] pair = [0, 0, 0];

            int isub1, isub2 = 0;

            if (z1 > csfHeight) { pair = j1; psub1 = j2; isub1 = i2; psub2 = j3; isub2 = i3;}
            else if (z2 > csfHeight) { pair = j2; psub1 = j1; isub1 = i1; psub2 = j3; isub2 = i3;}
            else { pair = j3; psub1 = j1; isub1 = i1; psub2 = j2; isub2 = i2;}

            real t1 = (csfHeight - psub1[2]) / (pair[2] - psub1[2]);

            real[int] pint1 = [psub1[0] + t1*(pair[0] - psub1[0]), psub1[1] + t1*(pair[1] - psub1[1]), psub1[2] + t1*(pair[2] - psub1[2])];

            real t2 = (csfHeight - psub2[2]) / (pair[2] - psub2[2]);

            real[int] pint2 = [psub2[0] + t2*(pair[0] - psub2[0]), psub2[1] + t2*(pair[1] - psub2[1]), psub2[2] + t2*(pair[2] - psub2[2])];

            // Force on Triangle A
            real [int] Ga = [(psub1[0] + psub2[0] + pint1[0])/3., (psub1[1] + psub2[1] + pint1[1])/3., (psub1[2] + psub2[2] + pint1[2])/3.];

            real[int] vA1 = [psub2[0] - psub1[0], psub2[1] - psub1[1], psub2[2] - psub1[2]];
            real[int] vA2 = [pint1[0] - psub1[0], pint1[1] - psub1[1], pint1[2] - psub1[2]];

            real Sa1 = crossProductX(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);
            real Sa2 = crossProductY(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);
            real Sa3 = crossProductZ(vA1[0], vA1[1], vA1[2], vA2[0], vA2[1], vA2[2]);

            real Sa = 0.5 * sqrt(Sa1*Sa1 + Sa2*Sa2 + Sa3*Sa3);
            real fluidFactorA = -rhoFluid *abs(g) * (csfHeight-Ga[2])*Sa;
            real[int] fluidForceA = [fluidFactorA * n[0], fluidFactorA * n[1], fluidFactorA*n[2]];

            // Force on Triangle B
            real [int] Gb = [(pint2[0] + psub2[0] + pint1[0])/3., (pint2[1] + psub2[1] + pint1[1])/3., (pint2[2] + psub2[2] + pint1[2])/3.];

            real[int] vB1 = [pint2[0] - psub2[0], pint2[1] - psub2[1], pint2[2] - psub2[2]];
            real[int] vB2 = [pint1[0] - psub2[0], pint1[1] - psub2[1], pint1[2] - psub2[2]];

            real Sb1 = crossProductX(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);
            real Sb2 = crossProductY(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);
            real Sb3 = crossProductZ(vB1[0], vB1[1], vB1[2], vB2[0], vB2[1], vB2[2]);

            real Sb = 0.5 * sqrt(Sb1*Sb1 + Sb2*Sb2 + Sb3*Sb3);
            real fluidFactorB = -rhoFluid *abs(g) * (csfHeight-Gb[2])*Sb;
            real[int] fluidForceB = [fluidFactorB * n[0], fluidFactorB * n[1], fluidFactorB*n[2]];

            real h1 = csfHeight - psub1[2];
            real h2 = csfHeight - psub2[2];
            real hSum = h1 + h2;
            if (hSum > 1e-9) {
                f1[][isub1] += fluidForceA[0] * h1/hSum;
                f2[][isub1] += fluidForceA[1] * h1/hSum;
                f3[][isub1] += fluidForceA[2] * h1/hSum;

                f1[][isub2] += fluidForceA[0] * h2/hSum + fluidForceB[0];
                f2[][isub2] += fluidForceA[1] * h2/hSum + fluidForceB[1];
                f3[][isub2] += fluidForceA[2] * h2/hSum + fluidForceB[2];
            }

            case2count++;
        }

        if(submergedCount==1){
            real[int] psub = [0, 0, 0];
            real[int] pair1 = [0, 0, 0];
            real[int] pair2 = [0, 0, 0];
            int isub;

            // Find which vertex is submerged
            if (z1 <= csfHeight) { psub = j1; isub = i1; pair1 = j2; pair2 = j3;}
            else if (z2 <= csfHeight) { psub = j2; isub = i2; pair1 = j1; pair2 = j3;}
            else { psub = j3; isub = i3; pair1 = j1; pair2 = j2;}

            real t1 = (csfHeight - psub[2]) / (pair1[2] - psub[2]);
            real[int] pint1 = [psub[0] + t1 * (pair1[0] - psub[0]), psub[1] + t1 * (pair1[1] - psub[1]), psub[2] + t1 * (pair1[2] - psub[2])];

            real t2 = (csfHeight - psub[2]) / (pair2[2] - psub[2]);
            real[int] pint2 = [psub[0] + t2 * (pair2[0] - psub[0]), psub[1] + t2 * (pair2[1] - psub[1]), psub[2] + t2 * (pair2[2] - psub[2])];

            real[int] G = [(psub[0] + pint2[0] + pint1[0])/3., (psub[1] + pint2[1] + pint1[1])/3., (psub[2] + pint2[2] + pint1[2])/3.];

            real [int] v1 = [pint1[0] - psub[0], pint1[1] - psub[1], pint1[2] - psub[2]];
            real [int] v2 = [pint2[0] - psub[0], pint2[1] - psub[1], pint2[2] - psub[2]];

            real S1 = crossProductX(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
            real S2 = crossProductY(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);
            real S3 = crossProductZ(v1[0], v1[1], v1[2], v2[0], v2[1], v2[2]);

            real S = 0.5 * sqrt(S1*S1 + S2*S2 + S3*S3);

            real fluidFactor = -rhoFluid * abs(g) * (csfHeight - G[2]) * S;

            real[int] fluidForce = [fluidFactor * n[0], fluidFactor * n[1], fluidFactor*n[2]];
            
            f1[][isub] += fluidForce[0];
            f2[][isub] += fluidForce[1];
            f3[][isub] += fluidForce[2];

            case1count++;
        }
    }
    real totalFz = 0;
    real totalFx = 0;
    real totalFy = 0;
    for(int i = 0; i < Th.nv; i++) {
        totalFz += f3[][i];
        totalFx += f1[][i];
        totalFy += f2[][i];
    }
    real totalFluidForce = sqrt(totalFx*totalFx + totalFy*totalFy + totalFz*totalFz);
    // cout << "    Total Fz (upward): " << totalFz << " N" << endl;
    // cout << "    Total Fx: " << totalFx << " N" << endl;
    // cout << "    Total Fy:: " << totalFy << " N" << endl;
    // cout << "    Total fluid force: " << totalFluidForce << " N" << endl;
    // cout << "    Triangles: " << processedTriangles << "/" << nbe << " (Case1:" << case1count << " Case2:" << case2count << " Case3:" << case3count << ")" << endl;
}


varf extForce([unused1,unused2,unused3], [w1,w2,w3]) =
    int3d(Th)(rho * g * w3);             // Gravity
    // + int3d(Th)(rho*f1*w1 + rho*f2*w2 + rho*f3*w3);   // Fluid forces
    // + on(z < occipitalPin || x>brainStemPin, unused1=0, unused2=0, unused3=0);  // BCs

// varf extForce([u1,u2,u3], [w1,w2,w3]) =
//     int3d(Th)(rho * g * w3) // Gravity
//     + int2d(Th, 1)( // Label 1 = Brain Surface
//         - (rhoFluid * abs(g) * max(0.0, currentCsfHeight - z)) * (N.x*w1 + N.y*w2 + N.z*w3);
//     )

varf intForce([unused1,unused2,unused3], [w1,w2,w3]) =
    int3d(Th)( 
          sigma11(u1,u2,u3)*epsilon11(w1,w2,w3)
        + sigma22(u1,u2,u3)*epsilon22(w1,w2,w3)  
        + sigma33(u1,u2,u3)*epsilon33(w1,w2,w3)
        + 2*sigma12(u1,u2,u3)*epsilon12(w1,w2,w3)
        + 2*sigma13(u1,u2,u3)*epsilon13(w1,w2,w3)
        + 2*sigma23(u1,u2,u3)*epsilon23(w1,w2,w3)
    );
    // + on((z < occipitalPin || x>brainStemPin), unused1=0, unused2=0, unused3=0);

int fixedNodes = 0;
for (int i = 0; i < Th.nv; i++) {
    if (Th(i).z < occipitalPin || Th(i).x > brainStemPin) {
        fixedNodes++;
    }
}
// cout << "Fixed nodes: " << fixedNodes << " / " << Th.nv << endl;
if(rank==0){
cout << "\n========================================" << endl;
cout << "Starting time integration" << endl;
cout << "========================================\n" << endl;
}

for (int step = 1; step <= nsteps; ++step) {

    real t = step * dt;
    if(rank==0)cout << "\n>>> Time step: " << step << " (t = " << t << " s)" << endl;

    // Update CSF height
    
    if (t <= drainTime) {
        currentCsfHeight = initialCsfHeight + (cutHeight - initialCsfHeight) * (t / drainTime);
    } else {
        currentCsfHeight = cutHeight;
    }
    if(rank==0)cout << "    CSF Height = " << currentCsfHeight << endl;
    
    // Calculate fluid forces based on current displacement
    calculateFluidForce(currentCsfHeight);

    // Assemble external force vector
    real[int] Rext = extForce(0, Vh3);
    for(int i=0;i < Th.nv;i++){
        Rext[i*3 + 0] += f1[][i];
        Rext[i*3 + 1] += f2[][i];
        Rext[i*3 + 2] += f3[][i];

    }
    
    // cout<<"1"<<endl;
    // Assemble internal force vector (from current displacement)
    real[int] Fint = intForce(0, Vh3);

    real[int] upred(Vh3.ndof);
    upred = u1old[];  // un
    
    real[int] temp(Vh3.ndof);
    temp = v1old[];
    temp *= dt;
    upred += temp;  // + dt*vn
    
    temp = a1old[];
    temp *= (dt*dt/4.);
    upred += temp;  // + (dt^2/4)*an

    // Predicted velocity
    real[int] vpred(Vh3.ndof);
    vpred = v1old[];
    temp = a1old[];
    temp *= (dt/2.);
    vpred += temp;  // vpred = vn + dt*an/2

    // Effective load vector for Newmark
    // Reff = Rext - K(upred) - C*vpred
    real[int] Reff(Vh3.ndof);
    Reff = Rext;
    real[int] KuPred(Vh3.ndof);
    KuPred = K * upred;
    Reff -= KuPred;  // Internal forces from CURRENT deformation
    // Reff -= Fint;

    
    temp = C * vpred;
    Reff -= temp;   // Damping
    
    // temp = M * a1old[];
    // temp *= (1.0 - gammanewmark);
    // Reff -= temp;   // Inertial term from previous acceleration

    // Scale by time step factors for Newmark
    // Reff *= (dt*dt);  // This gives the correct weighting

    // Solve for acceleration correction
    // Meff * anew = Reff

    real[int] anew(Vh3.ndof);
    // cout<<"2"<<endl;

    anew = Meff^-1 * Reff;
    // cout<<"3"<<endl;

    // Update acceleration, velocity, displacement
    a1[] = anew;
    
    // Velocity update: v{n+1} = vpred + gamma*dt*a{n+1}
    v1[] = vpred;
    temp = a1[];
    temp *= (gammanewmark*dt);
    v1[] += temp;

    // Displacement update: u{n+1} = upred + beta*dt^2*a{n+1}
    u1[] = upred;
    temp = a1[];
    temp *= (betanewmark*dt*dt);
    u1[] += temp;

    // // Apply boundary conditions explicitly (just to be safe)
    for (int i = 0; i < Th.nv; i++) {
        if (Th(i).z < occipitalPin || Th(i).x > brainStemPin) {
            u1[][i*3 + 0] = 0.0;
            u1[][i*3 + 1] = 0.0;
            u1[][i*3 + 2] = 0.0;
            v1[][i*3 + 0] = 0.0;
            v1[][i*3 + 1] = 0.0;
            v1[][i*3 + 2] = 0.0;
            a1[][i*3 + 0] = 0.0;
            a1[][i*3 + 1] = 0.0;
            a1[][i*3 + 2] = 0.0;
        }
    }

    // Store for next time step
    u1old[] = u1[];
    v1old[] = v1[];
    a1old[] = a1[];

    // Output some diagnostics
    real maxDisp = u1[].linfty;
    if(rank==0)cout << "    Max displacement magnitude: " << maxDisp << " m" << endl;
}

if(rank==0){cout << "Time integration complete" << endl;



// medit("Displacement", Th, u1, wait=true);
// medit("Displacement", Th, u2, wait=true);
// medit("Displacement", Th, u3, wait=true);


mesh3 ThDeformed = movemesh(Th, [x+u1, y+u2, z+u3]);

plot(Th, cmm="Original Mesh", value=true, boundary=true, wait=true); 
plot(ThDeformed, cmm="Deformed Mesh", value=true, wait=true);
plot(Th, ThDeformed, cmm="Overlay", value=true, wait=true);


// medit("3D Deformed Mesh", ThDeformed);

cout << "Done!" << endl;
}
