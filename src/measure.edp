load "msh3"
load "gmsh"

mesh3 Th = gmshload3("../models/brain_tumour_merged.msh");

// Collect unique labels
int[int] regionsSeen(1000);
regionsSeen = 0;
for(int i = 0; i < Th.nt; i++)
    regionsSeen[Th[i].region] = 1;

cout << "Volume regions found: ";
for(int i = 0; i < 1000; i++)
    if(regionsSeen[i]) cout << i << " ";
cout << endl;

// Same for boundary
int[int] labelsSeen(1000);
labelsSeen = 0;
for(int i = 0; i < Th.nbe; i++)
    labelsSeen[Th.be(i).label] = 1;

cout << "Boundary labels found: ";
for(int i = 0; i < 1000; i++)
    if(labelsSeen[i]) cout << i << " ";
cout << endl;
```

**2. The most likely cause** is that your `.geo` Physical Volume definitions didn't get picked up correctly — so everything got label 0 or 1. Can you share what the terminal output says when you run `gmsh brain_tumor2.geo -3 ...`? Specifically look for lines like:
```
Info: 2 volumes, 1 physical group